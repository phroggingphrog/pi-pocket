# Copy this file to .env. Keep .env private and out of source control.
POCKET_API_URL=http://127.0.0.1:8788
POCKET_OWNER_TOKEN=replace-with-disposable-test-owner-token
GATEWAY_PUBLIC_URL=http://127.0.0.1:8787
GATEWAY_CLIENT_ID=chatgpt-local
GATEWAY_CLIENT_SECRET=replace-with-32-random-characters
GATEWAY_APPROVAL_SECRET=replace-with-24-random-characters
GATEWAY_OWNER_ID=replace-with-owner-user-id
GATEWAY_WORKSPACE_ROOT=/tmp/pi-pocket-gateway-workspace
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_STATE_PATH=/tmp/pi-pocket-gateway/state.json
GATEWAY_ENABLED=false
GATEWAY_SOURCE_SESSION=1
PI_POCKET_DATA_DIR=/tmp/pi-pocket-disposable/data
PI_POCKET_PORT=8788
